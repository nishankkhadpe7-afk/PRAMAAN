# Pramaan local secrets TEMPLATE. Copy to .env and fill in; .env is git-ignored.
#
#   cp .env.example .env     (Windows: copy .env.example .env)

# --- Groq (OpenAI-compatible) LLM endpoint for the MCP agent console ---
GROQ_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Confirm the exact model slug in your Groq console (model names change over time).
LLM_MODEL=qwen/qwen3.8-27b

# --- Pramaan MCP identity token ---
# Issue one locally:  python -m Pramaan.backend.security issue --subject judge --role auditor --ttl 900
PRAMAAN_TOKEN=paste-an-issued-token-here

# --- Local upload boundary ---
# Maximum decoded register/evidence upload size. The default is 10 MiB.
PRAMAAN_MAX_UPLOAD_BYTES=10485760

# --- Optional: Streamable HTTP MCP transport (otherwise stdio is used) ---
# python -m Pramaan.backend.mcp_server --http
# PRAMAAN_MCP_URL=http://127.0.0.1:8001/mcp
