# Pramaan local secrets TEMPLATE. Copy to .env and fill in; .env is git-ignored.
#
#   cp .env.example .env     (Windows: copy .env.example .env)
#
# Never commit .env, and never keep old or "disabled" keys in it: delete and rotate them instead.

# --- Audit assistant LLM (any OpenAI-compatible endpoint; set ONE provider) ---
# The key is chosen by the endpoint's host, so a stray key is never sent to another provider.
#
# Google Gemini (OpenAI-compatible endpoint):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: comma-separated models tried in order when one model's quota is used up.
# LLM_FALLBACK_MODELS=gemini-2.5-flash-lite
#
# Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1   GROQ_API_KEY=...    LLM_MODEL=<model slug from your Groq console>
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1        OPENAI_API_KEY=...  LLM_MODEL=<model name>
# Other:    LLM_BASE_URL=<compatible endpoint>            LLM_API_KEY=...     LLM_MODEL=<model name>
# If LLM_BASE_URL is unset the code defaults to Groq with LLM_MODEL=llama-3.3-70b-versatile.

# --- Pramaan MCP identity token for EXTERNAL agents (Claude Desktop, other MCP clients) ---
# Always issue agent tokens with --agent: the server then applies the agent policy (no journal
# reversals, no books writes, no human review) whatever headers the agent sends.
#   python -m Pramaan.backend.security issue --subject my-agent --role auditor --agent --ttl 900
PRAMAAN_TOKEN=paste-an-issued-agent-token-here

# --- Local upload boundary ---
# Maximum decoded register/evidence upload size. The default is 10 MiB. Request bodies larger
# than this (as base64 JSON, plus 1 MiB) are rejected with HTTP 413 before parsing.
PRAMAAN_MAX_UPLOAD_BYTES=10485760

# --- Optional: agent writes to the client's books over MCP (default: denied) ---
# PRAMAAN_MCP_BOOKS_WRITES=allow

# --- Optional: Streamable HTTP MCP transport (otherwise stdio is used) ---
# python -m Pramaan.backend.mcp_server --http
# PRAMAAN_MCP_URL=http://127.0.0.1:8001/mcp
